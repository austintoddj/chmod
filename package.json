{
  "name": "what-the-chmod",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A beautiful Unix permissions calculator for that once-a-year occasion when you need to modify file access.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --host localhost --port 3000 --strictPort",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "e2e": "playwright test --project=chromium",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preflight": "bash bin/preflight.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  },
  "overrides": {
    "minimatch@>=7": "11.0.5"
  }
}
