{
  "name": "what-the-chmod",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A beautiful Unix permissions calculator for that once-a-year occasion when you need to modify file access.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preflight": "bash bin/preflight.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.6.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
